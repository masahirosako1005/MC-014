{
  "name": "mini-oshi",
  "version": "1.0.0",
  "private": true,
  "description": "ミニ推し！ 獲得した推しが実際の場所を旅する様子を見るWEBアプリ",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
